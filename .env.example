# ──────────────────────────────────────────────────────────────
#  TalentLens Environment Variables — copy to .env and fill in
# ──────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
SECRET_KEY=change-me-please
DEBUG=true

# ── Backend API ──────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API (CORS). Add every
# origin the frontend is actually served from — e.g. for LAN testing, add
# http://<your-LAN-IP>:3000 alongside localhost. See
# docs/infrastructure/environment-url-configuration.md.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Frontend (Next.js reads these from frontend/.env.local, NOT this file —
# they're listed here for reference; see the docs above for the split) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TalentLens

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=talentlens
POSTGRES_USER=talentlens_user
POSTGRES_PASSWORD=change-me-please
DATABASE_URL=postgresql://talentlens_user:change-me-please@postgres:5432/talentlens

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── AI Services ──────────────────────────────────────────────
LLM_PROVIDER=anthropic        # anthropic | openai
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-...         # optional fallback
OPENAI_MODEL=gpt-4o

# ── Embeddings (ai-services microservice — not used by the matching pipeline) ──
EMBEDDING_PROVIDER=openai     # openai | sentence_transformers
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2

# ── Local embeddings (backend — powers semantic matching, no external API calls) ──
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
LOCAL_EMBEDDING_DEVICE=cpu    # cpu | cuda
LOCAL_EMBEDDING_BATCH_SIZE=16

# ── Object Storage (S3-compatible) ───────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=talentlens-uploads
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1

# ── Email (SMTP) — assessment invitation delivery ────────────
# FRONTEND_BASE_URL is the ONLY thing that controls what URL goes into an
# invitation email (see app/services/assessment_invitation.py). This is the
# one setting to change when moving between local/LAN/staging/production —
# see docs/infrastructure/environment-url-configuration.md for the exact
# value per environment.
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@talentlens.io
SMTP_PASSWORD=change-me-please
SMTP_FROM_EMAIL=no-reply@talentlens.io
SMTP_FROM_NAME=TalentLens
SMTP_TLS=true
SMTP_SSL=false

# ── Auth / JWT ───────────────────────────────────────────────
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

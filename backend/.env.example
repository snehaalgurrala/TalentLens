# ── App ──────────────────────────────────────────────────────
APP_ENV=development
PROJECT_NAME=TalentLens
VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL ───────────────────────────────────────────────
# Set individual components or override with DATABASE_URL directly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talentlens
POSTGRES_USER=talentlens_user
POSTGRES_PASSWORD=change-me-please
# DATABASE_URL=postgresql+asyncpg://talentlens_user:change-me-please@localhost:5432/talentlens

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0
